{% extends "base.html.twig" %}

{% block title %}DBLegendsdle{% endblock %}

{% block body %}
<div class="fixed inset-0 -z-10 flex flex-col md:flex-row">
    <img src="{{ asset('assets/artes/shallotfondo.png') }}" class="w-full md:w-1/2 h-1/2 md:h-full object-cover opacity-70 transition-opacity hover:opacity-90">
    <img src="{{ asset('assets/artes/gibletfondo.png') }}" class="w-full md:w-1/2 h-1/2 md:h-full object-cover opacity-70 transition-opacity hover:opacity-90">
</div>

<header class="pt-6 sm:pt-8 md:pt-10 pb-3 sm:pb-4 md:pb-5 px-4">
    <div class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 animate-float">
        <img class="w-12 sm:w-16 md:w-20 animate-glow" src="{{ asset('assets/multimedia/logo.png') }}" alt="Logo">
        <h1 class="font-['Edo_SZ'] text-3xl sm:text-4xl md:text-5xl lg:text-6xl bg-gradient-to-br from-orange-400 via-orange-600 to-red-700 bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(249,115,22,0.5)] text-center">
            DBLegendsDle
        </h1>
    </div>
</header>

<main class="flex flex-col items-center justify-center pt-3 sm:pt-4 md:pt-5">
    <section class="text-center w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg xl:max-w-2xl bg-gradient-to-br from-orange-600 to-red-700 rounded-2xl p-4 sm:p-5 md:p-6 shadow-[0_0_30px_rgba(249,115,22,0.4)] border-2 border-orange-400 backdrop-blur-sm">
        <h2 class="font-['Edo_SZ'] text-xl sm:text-2xl md:text-3xl text-white drop-shadow-lg mb-2 sm:mb-3">Adivina el personaje de hoy de Dragon Ball Legends</h2>
        <p class="font-['Edo_SZ'] text-sm sm:text-base md:text-lg text-orange-50 mb-1 sm:mb-2">¡¡Contiene todos los personajes del juego, heros, extreme, sparking, ultras y lr, todos aquí!!</p>
        <p class="font-['Edo_SZ'] text-xs sm:text-sm md:text-base text-yellow-200 font-bold drop-shadow-md">Última actualización: Legend Super Vegeto</p>
        <div class="mt-3 inline-flex items-center justify-center gap-2 rounded-xl border border-yellow-300/70 bg-slate-950/40 px-4 py-2 shadow-[0_0_14px_rgba(234,179,8,0.25)]">
            <span class="text-lg" aria-hidden="true">🔥</span>
            <span class="font-['Edo_SZ'] text-xs sm:text-sm md:text-base text-yellow-100">Racha clasico: <strong id="classic-streak-count">0</strong> dias</span>
        </div>
    </section>

    <section class="w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg xl:max-w-2xl">
        <div class="group relative pt-6 sm:pt-8">
            <input id="search-input" type="text" placeholder="Escribe el nombre del personaje..." autocomplete="off" onkeydown="if(event.key==='Enter') event.preventDefault()" class="font-['Edo_SZ'] w-full p-3 sm:p-4 md:p-5 bg-slate-900/90 border-3 border-orange-600 text-white rounded-2xl placeholder:text-gray-400 focus:outline-none focus:border-orange-400 focus:shadow-[0_0_20px_rgba(249,115,22,0.5)] transition-all duration-300 text-sm sm:text-base md:text-lg backdrop-blur-sm">
        </div>
        <div id="result" class="font-['Edo_SZ'] w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg xl:max-w-2xl absolute mt-2 bg-slate-900/95 border-2 border-orange-600 text-white rounded-2xl max-h-60 sm:max-h-80 overflow-y-auto hidden z-60 shadow-[0_0_25px_rgba(0,0,0,0.5)] backdrop-blur-md left-1/2 transform -translate-x-1/2">
        </div>
    </section>

    <section class="w-full flex flex-col items-center pt-6 sm:pt-8 md:pt-10">
        <div class="w-full overflow-x-auto pb-4 custom-scrollbar">
            <div class="flex gap-2 mb-3 justify-center flex-nowrap min-w-max px-4">
                <div class="w-24 sm:w-28 md:w-32 h-20 sm:h-24 md:h-28 flex items-center justify-center text-center text-xs sm:text-sm font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white px-1">Personaje</div>
                <div class="w-28 sm:w-32 md:w-36 lg:w-40 h-20 sm:h-24 md:h-28 flex items-center justify-center text-center text-xs sm:text-sm font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white px-1">Género</div>
                <div class="w-28 sm:w-32 md:w-36 lg:w-40 h-20 sm:h-24 md:h-28 flex items-center justify-center text-center text-xs sm:text-sm font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white px-1">Afinidad</div>
                <div class="w-28 sm:w-32 md:w-36 lg:w-40 h-20 sm:h-24 md:h-28 flex items-center justify-center text-center text-xs sm:text-sm font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white px-1">Rareza</div>
                <div class="w-28 sm:w-32 md:w-36 lg:w-40 h-20 sm:h-24 md:h-28 flex items-center justify-center text-center text-xs sm:text-sm font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white px-1">Estilo</div>
                <div class="w-28 sm:w-32 md:w-36 lg:w-40 h-20 sm:h-24 md:h-28 flex items-center justify-center text-center text-xs sm:text-sm font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white px-1">Zenkai?</div>
                <div class="w-28 sm:w-32 md:w-36 lg:w-40 h-20 sm:h-24 md:h-28 flex items-center justify-center text-center text-xs sm:text-sm font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white px-1">Saga</div>
                <div class="w-28 sm:w-32 md:w-36 lg:w-40 h-20 sm:h-24 md:h-28 flex items-center justify-center text-center text-xs sm:text-sm font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white px-1">Raza/Ocupación</div>
                <div class="w-24 sm:w-28 md:w-32 h-20 sm:h-24 md:h-28 flex items-center justify-center text-center text-xs sm:text-sm font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white px-1">Año</div>
            </div>
            <div id="intentos-container" class="flex flex-col gap-2"></div>
        </div>
    </section>

    <div class="flex flex-wrap justify-center gap-4 mt-6">
    <div id="win-buttons" class="hidden flex flex-wrap justify-center gap-4">
        <a href="{{ path('app_artcart') }}" class="font-['Edo_SZ'] px-6 sm:px-8 py-2 sm:py-3 bg-gradient-to-r from-orange-600 to-red-700 text-white rounded-xl border-2 border-orange-400 hover:from-orange-500 hover:to-red-600 hover:shadow-[0_0_20px_rgba(249,115,22,0.6)] transition-all duration-300 text-sm sm:text-base md:text-lg font-bold">
            Jugar Art Cart
        </a>
        <button id="infinite-mode" class="font-['Edo_SZ'] px-6 sm:px-8 py-2 sm:py-3 bg-gradient-to-r from-yellow-600 to-orange-700 text-white rounded-xl border-2 border-yellow-400 hover:from-yellow-500 hover:to-orange-600 hover:shadow-[0_0_20px_rgba(234,179,8,0.6)] transition-all duration-300 text-sm sm:text-base md:text-lg font-bold">
            Modo Infinito
        </button>
    </div>
        <a href="{{ path('app_summon') }}" class="font-['Edo_SZ'] px-6 sm:px-8 py-2 sm:py-3 bg-gradient-to-r from-cyan-600 to-blue-800 text-white rounded-xl border-2 border-cyan-300 hover:from-cyan-500 hover:to-blue-700 hover:shadow-[0_0_20px_rgba(34,211,238,0.6)] transition-all duration-300 text-sm sm:text-base md:text-lg font-bold">
            Invocacion
        </a>
    </div>
</main>

{% endblock %}

{% block javascripts %}
<script src="{{ asset('assets/javascript/main.js') }}?v=20260525-3"></script>
{% endblock %}
