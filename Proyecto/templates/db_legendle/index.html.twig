{% extends "base.html.twig" %}

{% block title %}DBLegendsdle{% endblock %}

{% block body %}
<img src="{{ asset('assets/artes/shallotfondo.png') }}" class="fixed left-0 bottom-0 w-200 h-[80vh] -z-10 opacity-70 transition-opacity hover:opacity-90">
<img src="{{ asset('assets/artes/gibletfondo.png') }}" class="fixed right-0 bottom-0 w-200 h-[80vh] -z-10 opacity-70 transition-opacity hover:opacity-90">

<header class="pt-10 pb-5">
    <div class="flex items-center justify-center gap-4 animate-float">
        <img class="w-20 animate-glow" src="{{ asset('assets/multimedia/logo.png') }}" alt="Logo">
        <h1 class="font-['Edo_SZ'] text-6xl bg-gradient-to-br from-orange-400 via-orange-600 to-red-700 bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(249,115,22,0.5)]">
            DBLegendsDle
        </h1>
    </div>
</header>

<main class="flex flex-col items-center justify-center pt-5">
    <section class="text-center w-150 bg-gradient-to-br from-orange-600 to-red-700 rounded-2xl p-6 shadow-[0_0_30px_rgba(249,115,22,0.4)] border-2 border-orange-400 backdrop-blur-sm">
        <h2 class="font-['Edo_SZ'] text-3xl text-white drop-shadow-lg mb-3">Adivina el personaje de hoy de Dragon Ball Legends</h2>
        <p class="font-['Edo_SZ'] text-lg text-orange-50 mb-2">¡¡Contiene todos los personajes del juego, heros, extreme, sparking y ultras todos aquí!!</p>
        <p class="font-['Edo_SZ'] text-yellow-200 font-bold drop-shadow-md">Última actualización: Legend Super Vegeto</p>
    </section>

    <section>
        <div class="group relative pt-8">
            <input id="search-input" type="text" placeholder="Escribe el nombre del personaje..." autocomplete="off" onkeydown="if(event.key==='Enter') event.preventDefault()" class="font-['Edo_SZ'] w-120 p-5 bg-slate-900/90 border-3 border-orange-600 text-white rounded-2xl placeholder:text-gray-400 focus:outline-none focus:border-orange-400 focus:shadow-[0_0_20px_rgba(249,115,22,0.5)] transition-all duration-300 text-lg backdrop-blur-sm">
        </div>
        <div id="result" class="font-['Edo_SZ'] w-120 absolute mt-2 bg-slate-900/95 border-2 border-orange-600 text-white rounded-2xl max-h-80 overflow-y-auto hidden z-60 shadow-[0_0_25px_rgba(0,0,0,0.5)] backdrop-blur-md">
        </div>
    </section>

    <section class="pt-10 flex justify-center">
        <div class="flex gap-2 mb-3">
            <div class="w-20 h-12 flex items-center justify-center text-center text-base font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white">Personaje</div>
            <div class="w-24 h-12 flex items-center justify-center text-center text-base font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white">Género</div>
            <div class="w-24 h-12 flex items-center justify-center text-center text-base font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white">Afinidad</div>
            <div class="w-24 h-12 flex items-center justify-center text-center text-base font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white">Rareza</div>
            <div class="w-24 h-12 flex items-center justify-center text-center text-base font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white">Estilo</div>
            <div class="w-24 h-12 flex items-center justify-center text-center text-base font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white">Zenkai?</div>
            <div class="w-24 h-12 flex items-center justify-center text-center text-base font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white">Saga</div>
            <div class="w-24 h-12 flex items-center justify-center text-center text-base font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white">Raza/ Ocupación</div>
            <div class="w-20 h-12 flex items-center justify-center text-center text-base font-bold text-yellow-200 font-['Edo_SZ'] uppercase bg-slate-800/80 rounded-lg border-2 border-white">Año</div>
        </div>
    </section>

    <section id="intentos" class="pb-10"></section>

    <a href="{{ path('app_artcart') }}" class="font-['Edo_SZ'] px-8 py-3 bg-gradient-to-r from-orange-600 to-red-700 text-white rounded-xl border-2 border-orange-400 hover:from-orange-500 hover:to-red-600 hover:shadow-[0_0_20px_rgba(249,115,22,0.6)] transition-all duration-300 text-lg font-bold">
        🎨 Jugar Art Cart
    </a>
</main>

<footer class="bg-gradient-to-t from-slate-900 to-slate-800 py-6 mt-70 border-t-2 border-orange-600/30">
    <div class="flex flex-col items-center gap-4">
        <p class="text-center text-gray-400 font-['Edo_SZ'] text-sm">© 2026 DBLegendsDle</p>
    </div>
</footer>
{% endblock %}

{% block javascripts %}
<script>
    // API base path
    const API_BASE = '/api';
    let personajes = [];
    let elegidosEnRonda = new Set();

    const input = document.getElementById("search-input");
    const lista = document.getElementById("result");
    const intentosVarios = document.getElementById("intentos");

    let pruebaDia = {};

    function seleccionasPerso() {
        const idMin = 1;
        const idMax = 374;
        const rango = personajes.filter(p => p.id >= idMin && p.id <= idMax);

        if (personajes.length > 0) {
            const aleatorio = Math.floor(Math.random() * rango.length);
            pruebaDia = rango[aleatorio];
            console.log("Objetivo del día:", pruebaDia.id, pruebaDia.nombre);
        }
    }

    // Cargar datos desde la API
    fetch(API_BASE + '/characters')
        .then(response => response.json())
        .then(data => {
            personajes = data;
            seleccionasPerso();
            // Si hay texto en el input, actualizar el dropdown
            if (input.value.trim()) {
                input.dispatchEvent(new Event('input'));
            }
        })
        .catch(error => console.error('Error cargando personajes:', error));

    input.addEventListener('input', () => {
        const text = input.value.toLowerCase().trim();
        lista.classList.toggle("hidden", !text);

        if (!text) return;

        lista.innerHTML = personajes
            .filter(p =>
                p.nombre.toLowerCase().includes(text) &&
                !elegidosEnRonda.has(p.id)
            )
            .map(p => `
                <div onclick="elegir(event, ${p.id})" class="flex items-center p-3 hover:bg-orange-600/20 cursor-pointer border-b border-white/10 text-white font-['Edo_SZ']">
                    <img src="${p.art_cart_url}" class="w-10 h-10 rounded-full border border-orange-500 mr-3">
                    <span>${p.nombre}</span>
                </div>
            `).join('');
    });

    function elegir(event, id) {
        event.preventDefault();
        event.stopPropagation();
        
        const p = personajes.find(pers => pers.id === id);
        elegidosEnRonda.add(id);
        compararAtributos(p);

        if (p.id === pruebaDia.id) {
            alert("¡Has ganado!");
            setTimeout(() => {
                intentosVarios.innerHTML = "";
                elegidosEnRonda.clear();
                seleccionasPerso();
            }, 2000);
        }

        input.value = "";
        lista.classList.add("hidden");
    }

    function compararAtributos(usuario) {
        const fila = document.createElement("div");
        fila.className = "flex justify-center gap-2 mb-2";

        let html = `
            <div class="w-18 h-18 bg-slate-800 border-2 border-slate-700 rounded-md overflow-hidden flex-shrink-0">
                <img src="${usuario.art_cart_url}" class="w-full h-full object-cover" onerror="this.src='https://via.placeholder.com/150'">
            </div>
        `;

        Object.keys(pruebaDia.atributos).forEach(key => {
            const opcionUsu = usuario.atributos[key];
            const opcionAtri = pruebaDia.atributos[key];

            let color;
            if (opcionUsu === opcionAtri) {
                color = "bg-green-600";
            } else if (key === "raza" || key === "afinidad") {
                const valsUsu = opcionUsu.split("/");
                const valsAtri = opcionAtri.split("/");
                const tieneCoincidencia = valsUsu.some(v => valsAtri.includes(v));
                color = tieneCoincidencia ? "bg-orange-400" : "bg-red-600";
            } else {
                color = "bg-red-600";
            }

            html += `
                <div class="${color} w-24 h-18 flex items-center justify-center text-center text-[18px] font-bold rounded-md border-2 border-white/10 p-1 text-black uppercase font-['Edo_SZ']">
                    ${opcionUsu}
                </div>
            `;
        });

        const colorAnio = usuario.anio === pruebaDia.anio ? "bg-green-600" : "bg-red-600";
        const flecha = usuario.anio < pruebaDia.anio ? "↑" : "↓";
        const textoFlecha = usuario.anio === pruebaDia.anio ? "" : flecha;

        html += `
            <div class="${colorAnio} w-20 h-16 flex flex-col items-center justify-center font-bold rounded-md border-2 border-white/10 text-black font-['Edo_SZ']">
                <span>${usuario.anio}</span>
                <span class="text-xs">${textoFlecha}</span>
            </div>
        `;

        fila.innerHTML = html;
        intentosVarios.prepend(fila);
    }
</script>
{% endblock %}
