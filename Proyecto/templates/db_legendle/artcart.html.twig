{% extends "base.html.twig" %}

{% block title %}Art Cart - DBLegendsdle{% endblock %}

{% block body %}
<div class="fixed inset-0 -z-10 flex flex-col md:flex-row">
    <img src="{{ asset('assets/artes/shallotfondo.png') }}" class="w-full md:w-1/2 h-1/2 md:h-full object-cover opacity-70 transition-opacity hover:opacity-90">
    <img src="{{ asset('assets/artes/gibletfondo.png') }}" class="w-full md:w-1/2 h-1/2 md:h-full object-cover opacity-70 transition-opacity hover:opacity-90">
</div>

<header class="pt-6 sm:pt-8 md:pt-10 pb-3 sm:pb-4 md:pb-5 px-4">
    <div class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 animate-float">
        <img class="w-12 sm:w-16 md:w-20 animate-glow" src="{{ asset('assets/multimedia/logo.png') }}" alt="Logo">
        <h1 class="font-['Edo_SZ'] text-3xl sm:text-4xl md:text-5xl lg:text-6xl bg-gradient-to-br from-orange-400 via-orange-600 to-red-700 bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(249,115,22,0.5)] text-center">
            DBLegendsDle
        </h1>
    </div>
</header>

<main class="flex flex-col items-center justify-center pt-3 sm:pt-4 md:pt-5">
    <section class="text-center w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg xl:max-w-2xl bg-gradient-to-br from-orange-600 to-red-700 rounded-2xl p-4 sm:p-5 md:p-6 shadow-[0_0_30px_rgba(249,115,22,0.4)] border-2 border-orange-400 backdrop-blur-sm">
        <h2 class="font-['Edo_SZ'] text-xl sm:text-2xl md:text-3xl text-white drop-shadow-lg mb-2 sm:mb-3">Adivina el personaje por su arte</h2>
        <p class="font-['Edo_SZ'] text-sm sm:text-base md:text-lg text-orange-50 mb-1 sm:mb-2">La imagen se revelará progresivamente con cada intento</p>
        <p class="font-['Edo_SZ'] text-xs sm:text-sm md:text-base text-yellow-200 font-bold drop-shadow-md">Intentos: <span id="attempts">0</span></p>
    </section>

    <!-- Contenedor del arte -->
    <section class="pt-6 sm:pt-8 md:pt-10">
        <div class="relative w-80 h-80 sm:w-96 sm:h-96 md:w-[400px] md:h-[400px] bg-gradient-to-br from-slate-900 to-slate-800 rounded-2xl shadow-[0_0_30px_rgba(0,0,0,0.5)] border-3 border-orange-600 overflow-hidden">
            <div id="artReveal" class="absolute overflow-hidden transition-all duration-500">
                <img id="artImage" src="" alt="Character Art" class="w-full h-full object-cover">
            </div>
        </div>
    </section>

    <section class="pt-6 sm:pt-8">
        <div class="group relative">
            <input id="searchInput" type="text" placeholder="Escribe el nombre del personaje..." class="font-['Edo_SZ'] w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg xl:max-w-2xl p-3 sm:p-4 md:p-5 bg-slate-900/90 border-3 border-orange-600 text-white rounded-2xl placeholder:text-gray-400 focus:outline-none focus:border-orange-400 focus:shadow-[0_0_20px_rgba(249,115,22,0.5)] transition-all duration-300 text-sm sm:text-base md:text-lg backdrop-blur-sm">
        </div>
        <div id="suggestions" class="font-['Edo_SZ'] w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg xl:max-w-2xl absolute mt-2 bg-slate-900/95 border-2 border-orange-600 text-white rounded-2xl max-h-60 sm:max-h-80 overflow-y-auto hidden z-50 shadow-[0_0_25px_rgba(0,0,0,0.5)] backdrop-blur-md left-1/2 transform -translate-x-1/2">
        </div>
    </section>

    <section id="guessesContainer" class="pt-6 sm:pt-8 md:pt-10 pb-6 sm:pb-8 md:pb-10 flex justify-center">
        <div id="guessesGrid" class="w-full max-w-4xl grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3"></div>
    </section>
    
    <a href="{{ path('app_home') }}" class="font-['Edo_SZ'] px-6 sm:px-8 py-2 sm:py-3 bg-gradient-to-r from-orange-600 to-red-700 text-white rounded-xl border-2 border-orange-400 hover:from-orange-500 hover:to-red-600 hover:shadow-[0_0_20px_rgba(249,115,22,0.6)] transition-all duration-300 text-sm sm:text-base md:text-lg font-bold">
        Volver al Clásico
    </a>
</main>

{% endblock %}

{% block javascripts %}
<script src="{{ asset('assets/javascript/artcart.js') }}"></script>
{% endblock %}
