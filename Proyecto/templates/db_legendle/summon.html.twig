    {% extends "base.html.twig" %}

{% block title %}Invocacion - DBLegendsdle{% endblock %}

{% block body %}
<div class="fixed inset-0 -z-10 flex flex-col md:flex-row">
    <img src="{{ asset('assets/artes/shallotfondo.png') }}" class="w-full md:w-1/2 h-1/2 md:h-full object-cover opacity-70 transition-opacity hover:opacity-90">
    <img src="{{ asset('assets/artes/gibletfondo.png') }}" class="w-full md:w-1/2 h-1/2 md:h-full object-cover opacity-70 transition-opacity hover:opacity-90">
</div>

<header class="pt-6 sm:pt-8 md:pt-10 pb-3 sm:pb-4 md:pb-5 px-4">
    <div class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 animate-float">
        <img class="w-12 sm:w-16 md:w-20 animate-glow" src="{{ asset('assets/multimedia/logo.png') }}" alt="Logo">
        <h1 class="font-['Edo_SZ'] text-3xl sm:text-4xl md:text-5xl lg:text-6xl bg-gradient-to-br from-orange-400 via-orange-600 to-red-700 bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(249,115,22,0.5)] text-center">
            Invocacion
        </h1>
    </div>
</header>

<main class="flex flex-col items-center px-4 pb-10">
    <section class="summon-card w-full max-w-5xl rounded-2xl border-2 border-orange-400 shadow-[0_0_34px_rgba(249,115,22,0.35)] p-4 sm:p-6">
        <img src="{{ asset('assets/multimedia/bannerprueba.png') }}?v={{ summonBannerVersion }}" class="w-full rounded-xl border-2 border-yellow-300 shadow-[0_0_24px_rgba(234,179,8,0.35)]" alt="Banner de invocacion">

        <div class="flex flex-col items-center gap-3 mt-6">
            <button id="summon-button" class="font-['Edo_SZ'] inline-flex items-center justify-center gap-3 px-8 py-3 bg-gradient-to-r from-yellow-500 via-orange-500 to-red-700 text-white rounded-xl border-2 border-yellow-200 hover:brightness-110 hover:shadow-[0_0_24px_rgba(234,179,8,0.65)] transition-all duration-300 text-lg sm:text-xl font-bold">
                <img src="{{ asset('assets/multimedia/ccs.png') }}" class="w-7 h-7 object-contain" alt="CCS">
                Summon
            </button>
            <p id="summon-message" class="min-h-6 text-center text-yellow-100 font-semibold"></p>
        </div>

        <div id="summon-results" class="mt-6 grid grid-cols-2 sm:grid-cols-5 gap-3 sm:gap-4"></div>
    </section>

    <section class="w-full max-w-7xl mt-8">
        <button id="collection-toggle" class="font-['Edo_SZ'] w-full px-6 py-3 bg-slate-900/90 text-white rounded-xl border-2 border-orange-500 hover:bg-slate-800 transition-all">
            Ver todos los personajes
        </button>
        <div id="collection-grid" class="hidden mt-5 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3"></div>
    </section>

    <nav class="flex flex-wrap justify-center gap-4 mt-8">
        <a href="{{ path('app_home') }}" class="font-['Edo_SZ'] px-6 py-3 bg-gradient-to-r from-orange-600 to-red-700 text-white rounded-xl border-2 border-orange-400">
            Clasico
        </a>
        <a href="{{ path('app_artcart') }}" class="font-['Edo_SZ'] px-6 py-3 bg-gradient-to-r from-orange-600 to-red-700 text-white rounded-xl border-2 border-orange-400">
            Art Cart
        </a>
    </nav>
</main>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('assets/javascript/summon.js') }}?v=20260525-1"></script>
{% endblock %}
