{% extends 'base.html.twig' %}

{% block title %}Panel Admin{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="mb-8 text-center">
        <h1 class="font-['Edo_SZ'] text-4xl sm:text-5xl bg-gradient-to-br from-orange-400 to-red-700 bg-clip-text text-transparent">
            Panel de Administracion
        </h1>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 rounded-xl border px-4 py-3 text-white {{ label == 'success' ? 'border-green-500 bg-green-700/40' : 'border-red-500 bg-red-700/40' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <section class="mb-8 bg-slate-900/90 border-2 border-orange-600 rounded-2xl p-6 shadow-xl">
        <h2 class="font-['Edo_SZ'] text-2xl text-orange-300 mb-5">Cuentas registradas</h2>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-white border-collapse min-w-[760px]">
                <thead>
                    <tr class="border-b-2 border-orange-600/40 text-orange-400 font-['Edo_SZ'] uppercase text-sm">
                        <th class="p-3">ID</th>
                        <th class="p-3">Usuario</th>
                        <th class="p-3">Email</th>
                        <th class="p-3">Permisos</th>
                        <th class="p-3">Estado</th>
                        <th class="p-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr class="border-b border-white/10 hover:bg-orange-600/10 transition-colors">
                            <td class="p-3">{{ user.id }}</td>
                            <td class="p-3 font-bold">{{ user.username }}</td>
                            <td class="p-3">{{ user.email }}</td>
                            <td class="p-3">
                                {% for role in user.roles %}
                                    <span class="inline-block px-2 py-1 mb-1 bg-orange-600/30 border border-orange-500 rounded-md text-xs mr-1">
                                        {{ role }}
                                    </span>
                                {% endfor %}
                            </td>
                            <td class="p-3">
                                {% if user.banned %}
                                    <span class="px-2 py-1 bg-red-600/40 border border-red-500 rounded-md text-xs">Baneado</span>
                                {% else %}
                                    <span class="px-2 py-1 bg-green-600/30 border border-green-500 rounded-md text-xs">Activo</span>
                                {% endif %}
                            </td>
                            <td class="p-3">
                                <form method="post" action="{{ path('app_admin_user_permissions', { id: user.id }) }}" class="flex flex-wrap items-center gap-3" data-turbo="false">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_user_' ~ user.id) }}">
                                    <label class="inline-flex items-center gap-2 text-sm">
                                        <input type="checkbox" name="role_admin" value="1" class="accent-orange-500" {{ 'ROLE_ADMIN' in user.roles ? 'checked' : '' }}>
                                        Admin
                                    </label>
                                    <label class="inline-flex items-center gap-2 text-sm">
                                        <input type="checkbox" name="banned" value="1" class="accent-red-500" {{ user.banned ? 'checked' : '' }}>
                                        Ban
                                    </label>
                                    <button type="submit" class="px-3 py-2 bg-orange-600 hover:bg-orange-500 rounded-lg border border-orange-300 text-sm font-bold">
                                        Guardar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="p-4 text-center text-gray-400 italic">No hay usuarios registrados.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">
        <section class="bg-slate-900/90 border-2 border-orange-600 rounded-2xl p-6 shadow-xl">
            <div class="flex flex-col sm:flex-row sm:items-end gap-3 mb-5">
                <div class="flex-1">
                    <h2 class="font-['Edo_SZ'] text-2xl text-orange-300 mb-2">characters.json</h2>
                    <select id="character-picker" class="w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                        <option value="">Nuevo personaje</option>
                        {% for character in characters %}
                            <option value="{{ character.id }}">#{{ character.id }} - {{ character.nombre }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="button" id="load-character" class="px-4 py-3 bg-slate-700 hover:bg-slate-600 rounded-lg border border-white/20 text-white">
                    Cargar
                </button>
            </div>

            <form method="post" action="{{ path('app_admin_character_save') }}" class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_character_save') }}">
                <label class="text-white text-sm">ID
                    <input id="character-id" name="id" type="number" min="1" placeholder="Automatico si esta vacio" class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <label class="text-white text-sm">Nombre
                    <input id="character-nombre" name="nombre" required class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <label class="text-white text-sm">Anio
                    <input id="character-anio" name="anio" type="number" min="2018" required class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <label class="text-white text-sm">Foto art cart
                    <input id="character-art" name="art_cart_url" required placeholder="/assets/multimedia/arts/personaje.png" class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <label class="text-white text-sm">Genero
                    <input id="character-genero" name="genero" required class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <label class="text-white text-sm">Afinidad
                    <input id="character-afinidad" name="afinidad" required class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <label class="text-white text-sm">Rareza
                    <input id="character-rareza" name="rareza" required class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <label class="text-white text-sm">Estilo
                    <input id="character-estilo" name="estilo" required class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <label class="text-white text-sm">Zenkai
                    <input id="character-zenkai" name="zenkai" required class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <label class="text-white text-sm">Saga
                    <input id="character-saga" name="saga" required class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <label class="text-white text-sm sm:col-span-2">Raza/Ocupacion
                    <input id="character-raza" name="raza" required class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <div class="sm:col-span-2 flex justify-end">
                    <button type="submit" class="font-['Edo_SZ'] px-6 py-3 bg-gradient-to-r from-orange-600 to-red-700 text-white rounded-xl border-2 border-orange-400">
                        Guardar personaje
                    </button>
                </div>
            </form>
        </section>

        <section class="bg-slate-900/90 border-2 border-orange-600 rounded-2xl p-6 shadow-xl">
            <div class="flex flex-col sm:flex-row sm:items-end gap-3 mb-5">
                <div class="flex-1">
                    <h2 class="font-['Edo_SZ'] text-2xl text-orange-300 mb-2">splash.json</h2>
                    <select id="splash-picker" class="w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                        <option value="">Nuevo splash</option>
                        {% for splash in splashCharacters %}
                            <option value="{{ splash.id }}">#{{ splash.id }} - {{ splash.nombre }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="button" id="load-splash" class="px-4 py-3 bg-slate-700 hover:bg-slate-600 rounded-lg border border-white/20 text-white">
                    Cargar
                </button>
            </div>

            <form method="post" action="{{ path('app_admin_splash_save') }}" class="grid grid-cols-1 gap-4" data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_splash_save') }}">
                <label class="text-white text-sm">ID
                    <input id="splash-id" name="id" type="number" min="1" placeholder="Automatico si esta vacio" class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <label class="text-white text-sm">Nombre
                    <input id="splash-nombre" name="nombre" required class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <label class="text-white text-sm">Foto splash
                    <input id="splash-art" name="art_url" required placeholder="/assets/multimedia/splash/personaje.png" class="mt-1 w-full p-3 bg-slate-800 border border-orange-500 rounded-lg text-white">
                </label>
                <div class="flex justify-end">
                    <button type="submit" class="font-['Edo_SZ'] px-6 py-3 bg-gradient-to-r from-orange-600 to-red-700 text-white rounded-xl border-2 border-orange-400">
                        Guardar splash
                    </button>
                </div>
            </form>
        </section>
    </div>

    <div class="mt-8 flex justify-center">
        <a href="{{ path('app_home') }}" class="font-['Edo_SZ'] px-6 py-3 bg-slate-800 text-white rounded-xl border border-white/20 hover:bg-slate-700 transition-all">
            Volver al Inicio
        </a>
    </div>
</div>

<script type="application/json" id="characters-json">{{ characters|json_encode|raw }}</script>
<script type="application/json" id="splash-json">{{ splashCharacters|json_encode|raw }}</script>
<script>
    (function () {
        const characters = JSON.parse(document.getElementById('characters-json').textContent || '[]');
        const splashCharacters = JSON.parse(document.getElementById('splash-json').textContent || '[]');

        function byId(prefix, key) {
            return document.getElementById(prefix + '-' + key);
        }

        document.getElementById('load-character').addEventListener('click', () => {
            const id = Number(document.getElementById('character-picker').value);
            const character = characters.find((item) => Number(item.id) === id);
            const attrs = character && character.atributos ? character.atributos : {};

            byId('character', 'id').value = character ? character.id : '';
            byId('character', 'nombre').value = character ? character.nombre : '';
            byId('character', 'anio').value = character ? character.anio : '';
            byId('character', 'art').value = character ? character.art_cart_url : '';
            byId('character', 'genero').value = attrs.genero || '';
            byId('character', 'afinidad').value = attrs.afinidad || '';
            byId('character', 'rareza').value = attrs.rareza || '';
            byId('character', 'estilo').value = attrs.estilo || '';
            byId('character', 'zenkai').value = attrs.zenkai || '';
            byId('character', 'saga').value = attrs.saga || '';
            byId('character', 'raza').value = attrs.raza || '';
        });

        document.getElementById('load-splash').addEventListener('click', () => {
            const id = Number(document.getElementById('splash-picker').value);
            const splash = splashCharacters.find((item) => Number(item.id) === id);

            byId('splash', 'id').value = splash ? splash.id : '';
            byId('splash', 'nombre').value = splash ? splash.nombre : '';
            byId('splash', 'art').value = splash ? splash.art_url : '';
        });
    })();
</script>
{% endblock %}
