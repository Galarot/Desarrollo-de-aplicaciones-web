# This file is a "template" of which env vars need to be defined for your application
# Copy this file to .env.local, and fill in the values. If you turn off
# the self checks (APP_DEBUG=false), you also have to start the web server with
# `--quiet` or configure log/panel in config/packages/web_profiler.yaml.

# See .env.example for the list of defined vars

DATABASE_URL="sqlite:///%kernel.project_dir%/var/app.db"
# DATABASE_URL="mysql://app:app@127.0.0.1:3306/dblegends?serverVersion=8.0.32&charset=utf8mb4"

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=true
###< symfony/framework-bundle ###

###> symfony/web-profiler-bundle ###
# With this env var set to false, the profiler is disabled by default.
# Use the !controller URL to enable the profiler when needed. Works only in dev/test.
PROFILER_ENABLED=true
###< symfony/web-profiler-bundle ###

###> symfony/console ###
CONSOLE_COMMAND_PARALLELIZATION_ENABLED=1
###< symfony/console ###
